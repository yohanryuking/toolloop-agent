# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar para el agente
ANTHROPIC_MODEL=claude-sonnet-4-5

# URL de conexión a la base de datos (SQLAlchemy).
# Por defecto usa un archivo SQLite local, sin dependencias externas.
DATABASE_URL=sqlite+aiosqlite:///./toolloop.db

# Origen permitido para CORS (frontend en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173

# Opcional: API key de Tavily (https://tavily.com) para que `buscar_web` use
# resultados reales en vez de datos mockeados. Si se deja vacío, la tool
# responde con resultados simulados (sin depender de ninguna credencial).
TAVILY_API_KEY=
